    "lucide-react": "^0.536.0",
    "next": "^16.1.6",
    "planby": "^2.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.62.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^15.7.3",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^2.1.2",
    "recharts": "^3.1.2",
    "shaka-player": "^4.16.2",
