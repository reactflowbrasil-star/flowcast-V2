{
  "name": "frontend",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 5000",
    "build": "next build",
    "build:static": "NEXT_STATIC_EXPORT=true next build",
    "export": "next export",
    "build:export": "NEXT_STATIC_EXPORT=true npm run build:static",
    "build:full-static": "bash ./scripts/build-static.sh",
    "start": "node server.js",
    "serve:static": "npx serve out -p 5000",
    "lint": "next lint --dir src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "npm run i18n:audit && jest --ci --watchAll=false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:ci && npm run test:e2e",
    "playwright:install": "playwright install",
    "i18n:audit": "node scripts/i18n-audit.js",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
