# =============================================
# STREAMCORE FRONTEND - Environment Configuration
# =============================================
# For Docker: Edit docker-compose.yml instead
# For manual install: Copy this to .env.local and edit
#
#   cp .env.example .env.local
#   nano .env.local
# =============================================

# =============================================
# API CONFIGURATION
# =============================================
# Backend API URL (public, used by browser)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Internal API URL (server-only, for Docker/private network)
INTERNAL_API_URL=http://localhost:3000

# =============================================
# BRANDING
# =============================================
APP_NAME=StreamCore

# =============================================
# DEBUG
# =============================================
NEXT_PUBLIC_DEBUG_LOGS=false

# =============================================
# PROXY SECURITY (server-side only)
# =============================================
# Allowed upstream hosts for media proxy (comma-separated, or "*" for dev)
STREAMCORE_PROXY_ALLOWED_HOSTS=*
STREAMCORE_PROXY_REQUIRE_AUTH=false
STREAMCORE_PROXY_ALLOW_PRIVATE=true
