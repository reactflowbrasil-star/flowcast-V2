# =============================================
# STREAMCORE BACKEND - Environment Configuration
# =============================================
# For Docker: Edit docker-compose.yml instead
# For manual install: Copy this to .env and edit
#
#   cp .env.example .env
#   nano .env
# =============================================

# =============================================
# DATABASE (PostgreSQL)
# =============================================
DATABASE_URL=postgres://streamcore:your_password@localhost:5432/streamcore

# Pool settings
ALLOW_PG_POOLER=false
PG_MAX_CONNECTIONS=10
PG_MIN_CONNECTIONS=0
PG_ACQUIRE_TIMEOUT_SECS=30
PG_IDLE_TIMEOUT_SECS=300

# =============================================
# SERVER
# =============================================
SERVER_ADDRESS=0.0.0.0:3000
PUBLIC_BASE_URL=http://localhost:3000          # or configure in Admin UI
CORS_ALLOWED_ORIGINS=http://localhost:5000

# =============================================
# SECURITY (CHANGE THESE!)
# =============================================
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_secure_password

# =============================================
# APP CONFIG
# =============================================
CONTENT_OVERVIEW_MULTIPLIER=x1    # or configure in Admin UI
ADMIN_IMPORT_MAX_BYTES=1000000000
SKIP_MIGRATIONS=false
RESET_DB=false
DEBUG_MODE=false
RUST_LOG=iptv_backend=info,tower_http=warn,sqlx=warn

# =============================================
# BACKUP
# =============================================
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24

# =============================================
# STRIPE (Optional — can be configured via Admin UI > Settings > Payments instead)
# These are FALLBACK values; Admin UI values take priority.
# =============================================
STRIPE_SECRET_KEY=              # or configure in Admin UI (encrypted at rest)
STRIPE_WEBHOOK_SECRET=          # or configure in Admin UI (encrypted at rest)
STRIPE_CURRENCY=usd             # or configure in Admin UI
STRIPE_SUCCESS_URL=http://localhost:5000/credits/success   # or configure in Admin UI
STRIPE_CANCEL_URL=http://localhost:5000/credits/cancel     # or configure in Admin UI
# STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=                      # or configure in Admin UI

# =============================================
# ENCRYPTION (recommended for Admin UI secrets)
# =============================================
# Generate with: openssl rand -hex 32
# Encrypts SMTP passwords and Stripe keys saved via Admin UI with AES-256-GCM
# STREAMCORE_SMTP_KEY=

# =============================================
# MEDIA STORAGE
# =============================================
MEDIA_STORAGE_PATH=/media
VIDEO_UPLOAD_MAX_BYTES=5368709120
