/// Create reseller_api_keys table for reseller public API access
#[allow(dead_code)]
async fn create_reseller_api_keys_table(pool: &Pool<Sqlite>) -> Result<()> {
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS reseller_api_keys (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            reseller_id INTEGER NOT NULL,
            key_name TEXT NOT NULL,
            api_key_hash TEXT NOT NULL UNIQUE,
            api_key_prefix TEXT NOT NULL,
            
            -- Granular permissions (JSON array)
            permissions TEXT NOT NULL DEFAULT '["users:read","credits:read"]',
            
            -- CORS and security
            allowed_origins TEXT DEFAULT '*',
            ip_whitelist TEXT DEFAULT NULL,
            
            -- Rate limiting
            rate_limit_per_minute INTEGER DEFAULT 60,
            rate_limit_per_day INTEGER DEFAULT 10000,
            
            -- Status and audit
            is_active BOOLEAN DEFAULT 1,
            last_used_at DATETIME,
            total_requests INTEGER DEFAULT 0,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
            expires_at DATETIME DEFAULT NULL,
            
            FOREIGN KEY (reseller_id) REFERENCES users(id) ON DELETE CASCADE
        )
        "#,
    )
    .execute(pool)
    .await?;

    // Indexes for fast lookups
    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_reseller_api_keys_hash ON reseller_api_keys(api_key_hash)",
    )
    .execute(pool)
    .await?;
    sqlx::query("CREATE INDEX IF NOT EXISTS idx_reseller_api_keys_reseller ON reseller_api_keys(reseller_id)")
        .execute(pool)
        .await?;
    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_reseller_api_keys_active ON reseller_api_keys(is_active)",
    )
    .execute(pool)
    .await?;

    Ok(())
}

