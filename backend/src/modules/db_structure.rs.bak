/// Migration: Remove duplicate subtitles and add UNIQUE constraint
/// This should be run once to clean up existing databases
pub async fn migrate_deduplicate_subtitles(pool: &Pool<Sqlite>) -> Result<()> {
    println!("🔧 Running subtitle deduplication migration...");

    // Step 1: Remove duplicate content_subtitles (keep oldest by id)
    sqlx::query(
        r#"
        DELETE FROM content_subtitles
        WHERE id NOT IN (
            SELECT MIN(id)
            FROM content_subtitles
            GROUP BY content_id, language, file_path
        )
        "#,
    )
    .execute(pool)
    .await?;

    // Step 2: Remove duplicate episode_subtitles (keep oldest by id)
    sqlx::query(
        r#"
        DELETE FROM episode_subtitles
        WHERE id NOT IN (
            SELECT MIN(id)
            FROM episode_subtitles
            GROUP BY episode_id, language, file_path
        )
        "#,
    )
    .execute(pool)
    .await?;

    // Step 3: Create UNIQUE indexes if they don't exist
    // Note: SQLite doesn't support adding UNIQUE constraints to existing tables directly
    // So we use UNIQUE indexes instead
    sqlx::query(
        "CREATE UNIQUE INDEX IF NOT EXISTS idx_content_subtitles_unique ON content_subtitles(content_id, language, file_path)"
    )
    .execute(pool)
    .await?;

    sqlx::query(
        "CREATE UNIQUE INDEX IF NOT EXISTS idx_episode_subtitles_unique ON episode_subtitles(episode_id, language, file_path)"
    )
    .execute(pool)
    .await?;

    println!("✅ Subtitle deduplication migration completed");
    Ok(())
}

