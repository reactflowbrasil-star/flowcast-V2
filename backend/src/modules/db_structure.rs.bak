// Database structure definitions for IPTV System
//
// This module contains all the SQL statements to create the complete
// IPTV database structure from scratch.

use anyhow::Result;
use bcrypt::{hash, DEFAULT_COST};
use sqlx::{Pool, Sqlite};

pub(crate) const DEFAULT_TV_CHANNEL_CATEGORIES: &[&str] = &[
    "Entertainment",
    "Sports",
    "News",
    "Movies",
    "Series",
    "Kids",
    "Documentary",
    "Lifestyle",
    "Culture & Education",
    "International",
    "Spain",
    "USA",
];

/// Create all database tables in the correct order
#[allow(dead_code)]
pub async fn create_all_tables(pool: &Pool<Sqlite>) -> Result<()> {
    println!("🛠️  Creating database tables...");

    // Create tables in dependency order (no foreign keys first, then with foreign keys)

    // Independent tables (no foreign keys)
    create_config_table(pool).await?;
    create_system_config_table(pool).await?;
    create_system_info_table(pool).await?;
    create_categories_table(pool).await?;
    create_tv_channel_categories_table(pool).await?;
    create_epg_sources_table(pool).await?;
    // TV Providers (auto-ingest remote M3U with TTL)
    create_tv_providers_table(pool).await?;
    // Gift codes table (created here so migrations run on first bootstrap)
    create_gift_codes_table(pool).await?;
    create_events_table(pool).await?;
    create_master_api_keys_table(pool).await?;

    // User management (depends on itself)
    create_users_table(pool).await?;
    // Payments and purchases (depends on users)
    create_credit_purchases_table(pool).await?;
    // Billing transactions (depends on users)
    create_billing_transactions_table(pool).await?;

    // Content tables (depend on categories)
    create_content_table(pool).await?;

    // Series structure (depends on content)
    create_series_table(pool).await?;
    create_seasons_table(pool).await?;
    create_episodes_table(pool).await?;

    // External subtitles tables (movies and episodes)
    create_content_subtitles_table(pool).await?;
    create_episode_subtitles_table(pool).await?;

    // Events with schedules (depends on events)
    create_event_schedules_table(pool).await?;

    // User-related tables (depend on users)
    create_devices_table(pool).await?;
    create_user_devices_table(pool).await?;
    create_user_subscriptions_table(pool).await?;
    create_user_favorites_table(pool).await?;
    create_blacklisted_tokens_table(pool).await?;
    create_rate_limits_table(pool).await?;

    // Activity and logging tables (depend on users)
    create_activity_logs_table(pool).await?;
    create_user_login_history_table(pool).await?;
    create_user_viewing_history_table(pool).await?;
    create_user_watch_progress_table(pool).await?;
    create_security_incidents_table(pool).await?;
    create_security_bans_table(pool).await?;

    // Support system (depends on users)
    create_tickets_table(pool).await?; // Simple tickets table
    create_support_tickets_table(pool).await?; // Advanced tickets table
    create_ticket_messages_table(pool).await?;
    create_ticket_message_reads_table(pool).await?;

    // Media watcher
    create_media_watch_folders_table(pool).await?;

    // Reseller API keys for public API access
    create_reseller_api_keys_table(pool).await?;

    // Ensure new columns exist in existing deployments
    run_runtime_migrations(pool).await?;

    println!("✅ All tables created successfully");
    Ok(())
}

/// State of the schema after running ensure_database_schema
#[allow(dead_code)]
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum SchemaState {
    FreshInstall,
    Existing,
}

macro_rules! ensure_table {
    ($pool:expr, $name:expr, $create_fn:ident) => {{
        if !table_exists($pool, $name).await? {
            $create_fn($pool).await?;
            true
        } else {
            false
        }
    }};
}

#[allow(dead_code)]
/// Ensure every expected table exists without modifying existing data
pub async fn ensure_database_schema(pool: &Pool<Sqlite>) -> Result<SchemaState> {
    let config_created = ensure_table!(pool, "config", create_config_table);
    let system_config_created = ensure_table!(pool, "system_config", create_system_config_table);
    let system_info_created = ensure_table!(pool, "system_info", create_system_info_table);
    let categories_created = ensure_table!(pool, "categories", create_categories_table);
    let tv_channel_categories_created = ensure_table!(
        pool,
        "tv_channel_categories",
        create_tv_channel_categories_table
    );
    let epg_sources_created = ensure_table!(pool, "epg_sources", create_epg_sources_table);
    let events_created = ensure_table!(pool, "events", create_events_table);
    let master_api_keys_created =
        ensure_table!(pool, "master_api_keys", create_master_api_keys_table);

    let users_created = ensure_table!(pool, "users", create_users_table);
    ensure_table!(pool, "credit_purchases", create_credit_purchases_table);
    ensure_table!(
        pool,
        "billing_transactions",
        create_billing_transactions_table
    );

    ensure_table!(pool, "content", create_content_table);
    ensure_table!(pool, "series", create_series_table);
    ensure_table!(pool, "seasons", create_seasons_table);
    ensure_table!(pool, "episodes", create_episodes_table);

    // Ensure external subtitles tables exist on existing databases
    ensure_table!(pool, "content_subtitles", create_content_subtitles_table);
    ensure_table!(pool, "episode_subtitles", create_episode_subtitles_table);

    ensure_table!(pool, "event_schedules", create_event_schedules_table);
    ensure_table!(pool, "tv_providers", create_tv_providers_table);
    // Ensure gift_codes exists (safe on existing DBs)
    ensure_table!(pool, "gift_codes", create_gift_codes_table);

    ensure_table!(pool, "devices", create_devices_table);
    ensure_table!(pool, "user_devices", create_user_devices_table);
    ensure_table!(pool, "user_subscriptions", create_user_subscriptions_table);
    ensure_table!(pool, "user_favorites", create_user_favorites_table);
    ensure_table!(pool, "blacklisted_tokens", create_blacklisted_tokens_table);
    ensure_table!(pool, "rate_limits", create_rate_limits_table);

    ensure_table!(pool, "activity_logs", create_activity_logs_table);
    ensure_table!(pool, "user_login_history", create_user_login_history_table);
    ensure_table!(
        pool,
        "user_viewing_history",
        create_user_viewing_history_table
    );
    ensure_table!(
        pool,
        "user_watch_progress",
        create_user_watch_progress_table
    );
    ensure_table!(pool, "security_incidents", create_security_incidents_table);
    ensure_table!(pool, "security_bans", create_security_bans_table);

    ensure_table!(pool, "tickets", create_tickets_table);
    ensure_table!(pool, "support_tickets", create_support_tickets_table);
    ensure_table!(pool, "ticket_messages", create_ticket_messages_table);
    ensure_table!(
        pool,
        "ticket_message_reads",
        create_ticket_message_reads_table
    );

    ensure_table!(pool, "reseller_logs", create_reseller_logs_table);
    ensure_table!(
        pool,
        "media_watch_folders",
        create_media_watch_folders_table
    );
    ensure_table!(pool, "reseller_api_keys", create_reseller_api_keys_table);

    run_runtime_migrations(pool).await?;

    let core_tables_created = config_created
        || system_config_created
        || system_info_created
        || categories_created
        || epg_sources_created
        || events_created
        || master_api_keys_created
        || users_created
        || tv_channel_categories_created;

    let state = if users_created && core_tables_created {
        SchemaState::FreshInstall
    } else {
        SchemaState::Existing
    };

    Ok(state)
}

#[allow(dead_code)]
/// Ensure default admin account exists with predefined credentials
pub async fn ensure_default_admin_user(pool: &Pool<Sqlite>) -> Result<()> {
    let existing_admin =
        sqlx::query_scalar::<_, i64>("SELECT id FROM users WHERE username = ? LIMIT 1")
            .bind("admin")
            .fetch_optional(pool)
            .await?;

    if existing_admin.is_some() {
        return Ok(());
    }

    // SECURITY FIX: Use environment variable for admin password
    // If not provided, use a temporary password that MUST be changed on first login
    let default_password = std::env::var("ADMIN_DEFAULT_PASSWORD").unwrap_or_else(|_| {
        // Generate a unique temporary password using timestamp
        let timestamp = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap_or_default()
            .as_nanos();
        let password = format!("tmp_{:x}", timestamp);
        // Log the generated password so admin can access the system
        // This will only happen on first install
        println!(
            "⚠️  IMPORTANT: Generated temporary admin password: {}",
            password
        );
        println!("⚠️  Please change this password immediately after first login!");
        println!("⚠️  Or set ADMIN_DEFAULT_PASSWORD environment variable before first run.");
        password
    });

    let password_hash = hash(&default_password, DEFAULT_COST)?;

    sqlx::query(
        "INSERT INTO users (username, password_hash, role, email, active) VALUES (?, ?, 'admin', ?, 1)",
    )
    .bind("admin")
    .bind(password_hash)
    .bind("admin@admin.com")
    .execute(pool)
    .await?;

    println!("👤 Created default admin user 'admin'");

    Ok(())
}

#[allow(dead_code)]
pub async fn ensure_default_categories(pool: &Pool<Sqlite>) -> Result<()> {
    const DEFAULT_CATEGORIES: &[(&str, &str)] = &[
        ("VOD Movies", "VOD"),
        ("TV Channels", "TV"),
        ("TV Series", "Series"),
        ("Events", "Eventos"),
        ("Kids Content", "Kids"),
        ("Anime", "Anime"),
    ];

    for (name, category_type) in DEFAULT_CATEGORIES {
        // Check existence by either legacy `type` or new `category_type` column
        let exists = sqlx::query_scalar::<_, i64>(
            "SELECT COUNT(*) FROM categories WHERE type = ? OR category_type = ?",
        )
        .bind(category_type)
        .bind(category_type)
        .fetch_one(pool)
        .await?;

        if exists == 0 {
            // Populate both legacy `type` and canonical `category_type` for new installs
            sqlx::query("INSERT INTO categories (name, type, category_type) VALUES (?, ?, ?)")
                .bind(name)
                .bind(category_type)
                .bind(category_type)
                .execute(pool)
                .await?;
            println!(
                "📁 Added default category '{}' ({}) to categories table",
                name, category_type
            );
        }
    }

    Ok(())
}

#[allow(dead_code)]
pub async fn ensure_system_info_record(pool: &Pool<Sqlite>) -> Result<()> {
    let exists = sqlx::query_scalar::<_, i64>("SELECT COUNT(*) FROM system_info WHERE id = 1")
        .fetch_one(pool)
        .await?;

    if exists == 0 {
        sqlx::query("INSERT INTO system_info (id, version) VALUES (1, '1.0.0')")
            .execute(pool)
            .await?;
        println!("ℹ️  Initialized system_info record");
    }

    Ok(())
}

#[allow(dead_code)]
pub async fn ensure_default_tv_channel_categories(pool: &Pool<Sqlite>) -> Result<()> {
    let existing_count = sqlx::query_scalar::<_, i64>("SELECT COUNT(*) FROM tv_channel_categories")
        .fetch_one(pool)
        .await?;

    if existing_count == 0 {
        for name in DEFAULT_TV_CHANNEL_CATEGORIES {
            sqlx::query("INSERT OR IGNORE INTO tv_channel_categories (name) VALUES (?)")
                .bind(name)
                .execute(pool)
                .await?;
        }
    }

    Ok(())
}

#[allow(dead_code)]
async fn table_exists(pool: &Pool<Sqlite>, table_name: &str) -> Result<bool> {
    let exists = sqlx::query_scalar::<_, i64>(
        "SELECT COUNT(*) FROM sqlite_master WHERE type = 'table' AND name = ?",
    )
    .bind(table_name)
    .fetch_one(pool)
    .await?;

    Ok(exists > 0)
}

/// Create users table - Core user management
#[allow(dead_code)]
async fn create_users_table(pool: &Pool<Sqlite>) -> Result<()> {
    sqlx::query(
        r#"
        CREATE TABLE users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            username TEXT UNIQUE NOT NULL,
            password_hash TEXT NOT NULL,
            role TEXT NOT NULL CHECK (role IN ('admin', 'reseller', 'end_user')),
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
            updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,

            -- Demo account management
            daily_demo_limit INTEGER DEFAULT NULL,
            demos_created_today INTEGER DEFAULT NULL,
            last_demo_reset_date DATE DEFAULT NULL,
            is_demo BOOLEAN DEFAULT NULL,
            demo_expires_at DATETIME DEFAULT NULL,

            -- User profile
            email TEXT,
            credits REAL DEFAULT 0.0,
            active BOOLEAN DEFAULT 1,

            -- Account hierarchy
            created_by INTEGER DEFAULT NULL,
            max_devices INTEGER DEFAULT 1,
            expires_at DATETIME DEFAULT NULL,

            FOREIGN KEY (created_by) REFERENCES users(id)
        )
        "#,
    )
    .execute(pool)
    .await?;

    Ok(())
}

