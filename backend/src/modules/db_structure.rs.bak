    .execute(pool)
    .await?;

    // Create indexes for performance and queries
    sqlx::query("CREATE INDEX idx_reseller_logs_reseller_id ON reseller_logs(reseller_id)")
        .execute(pool)
        .await?;
    sqlx::query("CREATE INDEX idx_reseller_logs_created_at ON reseller_logs(created_at)")
        .execute(pool)
        .await?;
    sqlx::query(
