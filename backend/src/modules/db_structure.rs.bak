/// Create content table - Main content storage
#[allow(dead_code)]
async fn create_content_table(pool: &Pool<Sqlite>) -> Result<()> {
    sqlx::query(
        r#"
        CREATE TABLE content (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            category_id INTEGER,

            -- Basic content info
            title TEXT NOT NULL,
            description TEXT,
            image_url TEXT,
            backdrop_url TEXT,

            -- Media info
            year INTEGER,
            stream_url TEXT,
            encrypted_stream_url TEXT,
            file_path TEXT,
            duration INTEGER,
            rating REAL,
            genre TEXT,
            tmdb_id INTEGER,

            -- Status and visibility
            is_active BOOLEAN DEFAULT 1,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
            active BOOLEAN DEFAULT 1,

            -- Provider and regional info
            provider TEXT,
            country TEXT,
            format TEXT,

            -- DRM and security
            drm_keys TEXT,
            drm_type TEXT,              -- 'clearkey', 'widevine', 'playready', or NULL
            license_server_url TEXT,    -- URL for Widevine/PlayReady license server
            drm_headers TEXT,           -- JSON string with custom headers for license requests
            quality TEXT,
            language TEXT,
            subtitle_languages TEXT,
            audio_languages TEXT,

            -- TV specific
            channel_number INTEGER,
            is_live BOOLEAN DEFAULT 0,

            -- EPG integration
            epg_source_id INTEGER,
            epg_channel_id TEXT,
            epg_offset_minutes BIGINT DEFAULT 0,

            -- LiveTV headers (for external streams)
            origin TEXT,
            user_agent TEXT,
            referer TEXT,
            custom_headers TEXT,
            proxy_url TEXT,
            doh_url TEXT,

            FOREIGN KEY (category_id) REFERENCES categories(id)
        )
        "#,
    )
    .execute(pool)
    .await?;

    // Create indexes for performance
    sqlx::query("CREATE INDEX idx_content_epg_source ON content(epg_source_id)")
        .execute(pool)
        .await?;

    Ok(())
}

