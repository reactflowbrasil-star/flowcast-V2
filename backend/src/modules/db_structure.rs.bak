/// Fix broken foreign key constraint in existing event_schedules table
#[allow(dead_code)]
pub async fn fix_event_schedules_foreign_key(pool: &Pool<Sqlite>) -> Result<()> {
    println!("🔧 Fixing broken foreign key constraint in event_schedules table...");

    // Check current foreign key constraint
    let current_fk: Option<String> = sqlx::query_scalar(
        "SELECT sql FROM sqlite_master WHERE type='table' AND name='event_schedules'",
    )
    .fetch_optional(pool)
    .await?
    .and_then(|sql: String| {
        if sql.contains("events_old") {
            Some("events_old".to_string())
        } else {
            None
        }
    });

    if current_fk.is_some() {
        println!("⚠️  Found broken foreign key constraint pointing to 'events_old'");

        // Check if there are any records that would violate the constraint
        let orphaned_count: i64 = sqlx::query_scalar(
            "SELECT COUNT(*) FROM event_schedules WHERE event_id IS NOT NULL AND event_id NOT IN (SELECT id FROM events)"
        )
        .fetch_one(pool)
        .await?;

        if orphaned_count > 0 {
            println!(
                "⚠️  Found {} orphaned records in event_schedules. These will be deleted.",
                orphaned_count
            );
            // Delete orphaned records
            sqlx::query("DELETE FROM event_schedules WHERE event_id IS NOT NULL AND event_id NOT IN (SELECT id FROM events)")
                .execute(pool)
                .await?;
        }

        // SQLite doesn't support DROP CONSTRAINT directly, so we need to recreate the table
        sqlx::query(
            r#"
            -- Create new table with correct foreign key
            CREATE TABLE event_schedules_new (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                event_id INTEGER,
                start_time DATETIME NOT NULL,
                end_time DATETIME,
                stream_url TEXT,
                encrypted_stream_url TEXT,
                created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
                FOREIGN KEY (event_id) REFERENCES events(id)
            )
            "#,
        )
        .execute(pool)
        .await?;

        // Copy data from old table to new table
        sqlx::query(
            r#"
            INSERT INTO event_schedules_new (id, event_id, start_time, end_time, stream_url, encrypted_stream_url, created_at)
            SELECT id, event_id, start_time, end_time, stream_url, encrypted_stream_url, created_at
            FROM event_schedules
            "#
        )
        .execute(pool)
        .await?;

        // Replace old table with new table
        sqlx::query("DROP TABLE event_schedules")
            .execute(pool)
            .await?;
        sqlx::query("ALTER TABLE event_schedules_new RENAME TO event_schedules")
            .execute(pool)
            .await?;

        println!("✅ Foreign key constraint in event_schedules table fixed successfully");
    } else {
        println!("ℹ️  Foreign key constraint in event_schedules table is already correct");
    }

    Ok(())
}

