/// Create gift_codes and gift_code_redemptions tables
#[allow(dead_code)]
async fn create_gift_codes_table(pool: &Pool<Sqlite>) -> Result<()> {
    tracing::info!("Creating gift_codes and gift_code_redemptions tables...");
    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS gift_codes (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            code TEXT NOT NULL UNIQUE,
            duration_days INTEGER NOT NULL,
            uses_total INTEGER NOT NULL DEFAULT 1,
            uses_remaining INTEGER NOT NULL DEFAULT 1,
            expires_at TEXT NULL,
            allowed_categories TEXT NULL,
            max_devices INTEGER NULL,
            created_by INTEGER NOT NULL,
            created_at TEXT NOT NULL DEFAULT (datetime('now'))
        );
        CREATE INDEX IF NOT EXISTS idx_gift_codes_code ON gift_codes(code);
        "#,
    )
    .execute(pool)
    .await?;

    sqlx::query(
        r#"
        CREATE TABLE IF NOT EXISTS gift_code_redemptions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            gift_code_id INTEGER NOT NULL,
            redeemer_user_id INTEGER NULL,
            redeemer_username TEXT NULL,
            redeemer_email TEXT NULL,
            redeemed_at TEXT NOT NULL DEFAULT (datetime('now')),
            duration_days_granted INTEGER NOT NULL,
            granted_categories TEXT NULL,
            granted_max_devices INTEGER NULL,
            FOREIGN KEY (gift_code_id) REFERENCES gift_codes(id) ON DELETE CASCADE
        );
        CREATE INDEX IF NOT EXISTS idx_gcredeem_giftcode_id ON gift_code_redemptions(gift_code_id);
        "#,
    )
    .execute(pool)
    .await?;
    tracing::info!("✅ gift_codes tables created");
    Ok(())
}

/// Ensure required public endpoint config keys exist with sensible defaults
/// - public_demo_enabled: "true"
/// - public_redeem_enabled: "true"
/// - demo_creation_threshold: "3"
/// - demo_ban_duration_days: "15"
pub async fn ensure_public_endpoints_config(pool: &Pool<Sqlite>) -> Result<()> {
    // Flags to enable/disable public endpoints from Admin UI
    sqlx::query("INSERT OR IGNORE INTO config (key, value) VALUES ('public_demo_enabled', 'true')")
        .execute(pool)
        .await?;
    sqlx::query(
        "INSERT OR IGNORE INTO config (key, value) VALUES ('public_redeem_enabled', 'true')",
    )
    .execute(pool)
    .await?;

    // Demo abuse control defaults
    sqlx::query(
        "INSERT OR IGNORE INTO config (key, value) VALUES ('demo_creation_threshold', '3')",
    )
    .execute(pool)
    .await?;
    sqlx::query(
        "INSERT OR IGNORE INTO config (key, value) VALUES ('demo_ban_duration_days', '15')",
    )
    .execute(pool)
    .await?;
    sqlx::query("INSERT OR IGNORE INTO config (key, value) VALUES ('demo_duration_hours', '12')")
        .execute(pool)
        .await?;

    Ok(())
}

