        .execute(pool)
        .await?;
    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_content_subtitles_lang ON content_subtitles(language)",
    )
    .execute(pool)
    .await?;
    Ok(())
}

#[allow(dead_code)]
async fn create_episode_subtitles_table(pool: &Pool<Sqlite>) -> Result<()> {
    sqlx::query(
        r#"
        CREATE TABLE episode_subtitles (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            episode_id INTEGER NOT NULL,
            language TEXT NOT NULL,         -- ISO 639-1 (e.g., 'en', 'es', 'fr')
            file_path TEXT NOT NULL,        -- Absolute path to .srt on disk
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
            FOREIGN KEY (episode_id) REFERENCES episodes(id) ON DELETE CASCADE,
            UNIQUE(episode_id, language, file_path)  -- Prevent duplicate subtitles
        )
        "#,
    )
    .execute(pool)
    .await?;
    // Indexes for fast lookups
    sqlx::query("CREATE INDEX IF NOT EXISTS idx_episode_subtitles_episode_id ON episode_subtitles(episode_id)")
        .execute(pool)
        .await?;
    sqlx::query(
        "CREATE INDEX IF NOT EXISTS idx_episode_subtitles_lang ON episode_subtitles(language)",
    )
    .execute(pool)
    .await?;
    Ok(())
}

