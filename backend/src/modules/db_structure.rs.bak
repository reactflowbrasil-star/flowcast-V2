    )
    .execute(pool)
    .await?;
    sqlx::query("CREATE INDEX idx_reseller_logs_credits_cost ON reseller_logs(credits_cost)")
        .execute(pool)
        .await?;

    tracing::info!("✅ reseller_logs table created successfully");
    Ok(())
}

