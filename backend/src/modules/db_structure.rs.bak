        sqlx::query("ALTER TABLE content ADD COLUMN doh_url TEXT")
            .execute(pool)
            .await?;
        println!("✅ Added 'doh_url' column to 'content' table");
    }

    Ok(())
}

/// Add category_type column to categories table if missing (and backfill from legacy `type`)
pub async fn add_category_type_column_if_missing(pool: &Pool<Sqlite>) -> Result<()> {
    use sqlx::Row;

    // Check if 'category_type' column exists on 'categories' table
    let rows = sqlx::query("PRAGMA table_info(categories)")
        .fetch_all(pool)
        .await?;

    let mut has_category_type = false;
    for row in rows {
        let name: String = row.get("name");
        if name.eq_ignore_ascii_case("category_type") {
            has_category_type = true;
            break;
        }
    }

    if !has_category_type {
        sqlx::query("ALTER TABLE categories ADD COLUMN category_type TEXT")
            .execute(pool)
            .await?;
        println!("✅ Added 'category_type' column to 'categories' table");

        // Backfill category_type from legacy type column for existing rows
        sqlx::query("UPDATE categories SET category_type = type WHERE category_type IS NULL OR category_type = ''")
            .execute(pool)
            .await?;
        println!("ℹ️  Backfilled 'category_type' from legacy 'type' column");
    }

    Ok(())
}

